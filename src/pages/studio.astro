---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Picture from '../components/Picture.astro';
import Cta from '../components/Cta.astro';
import { site } from '../data/site';
import { team } from '../data/team';
import { progetto } from '../data/progetti';
import { numeriStudio, approccio, competenzeStudio } from '../data/contenuti';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Chi siamo', href: '/studio/' }];
const hero = progetto('manutenzione-facciata').immagini[1];
const foto = [progetto('rinnovo-cucina').immagini[1], progetto('pittura-antimuffa').immagini[0]];
// Le specializzazioni dichiarate dall'impresa (al posto della rete di collaboratori della base)
const persone = site.competenze;
---
<Layout title="Chi siamo | Impresa Edile Mario, impresa edile a Savona" description="Impresa Edile Mario, di Shabanaj Erzen: ristrutturazioni e opere edili a Savona e provincia, con consulenze personalizzate e preventivi gratuiti." pageType="AboutPage" ogType="article" transparent crumbs={crumbs}>
<PageHero img={hero} crumbs={crumbs} eyebrow="Chi siamo"> <h1 class="h1-page">Tradizione artigianale <em style="color: var(--accent-on-dark)">e tecniche moderne</em></h1> <p class="lead">Un’impresa edile con sede a Savona, per ristrutturazioni e opere edili in tutta la provincia.</p> </PageHero>
<section class="section"> <div class="container split"> <div class="reveal"> <p class="eyebrow mb-2">L’impresa</p> <h2 class="h2">{site.nome}</h2> </div> <div class="prose lead reveal"> <p>L’Impresa Edile di Shabanaj Erzen, con sede a Savona in via Fratelli Canepa 6/10, è un punto di riferimento per ristrutturazioni e opere edili in tutta la provincia.</p> <p>Uno staff di professionisti qualificati segue ogni cliente con consulenze personalizzate e preventivi gratuiti, sempre nel rispetto del budget concordato.</p> </div> </div> <div class="container mt-4"> <div class="stats reveal"> {numeriStudio.map((s) => <div class="stat"><strong>{s.n}</strong><span>{s.label}</span></div>)} </div> </div> </section>
<section class="section bg-sand"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow">Il nostro approccio</p> <h2 class="h2">Serietà e professionalità</h2> </div> </div> <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 2.5rem"> {approccio.map((a, i) => <div class="reveal border-top" style={`padding-top:1.5rem; transition-delay:${i * 80}ms`}> <p class="eyebrow mb-2">{String(i + 1).padStart(2, '0')}</p> <h3 class="h3 mb-2">{a.titolo}</h3> <p>{a.testo}</p> </div>)} </div> <div class="grid-2 mt-4"> {foto.map((f) => <div class="ratio-32 reveal"><Picture img={f} sizes="(min-width: 1024px) 45vw, 92vw" /></div>)} </div> </div> </section>
<section class="section" id="team"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow">Il titolare</p> <h2 class="h2">Chi guida {site.nome}</h2> <p class="lead mt-2">Tradizione artigianale e tecniche moderne. Il titolare e il suo staff seguono ogni lavoro, dal piccolo intervento alla ristrutturazione completa.</p> </div> </div> <ul class="team-grid"> {team.map((m, i) => <li class="member reveal" id={m.id} style={`transition-delay:${(i % 4) * 60}ms`}> <div class="photo"><Picture img={m.foto} sizes="(min-width: 1100px) 22vw, (min-width: 768px) 30vw, 46vw" /></div> <h3>{m.nome}</h3> <p>{m.ruolo}</p> {m.bio && <p style="text-transform:none; letter-spacing:0; color:var(--text); font-size:.9375rem; font-weight:400; line-height:1.6; margin-top:.9rem">{m.bio}</p>} </li>)} </ul> <div class="mt-4 reveal"> <p class="eyebrow mb-2">Specializzazioni</p> <ul class="checklist" style="columns: 2; column-gap: 2.5rem">{persone.map((x) => <li>{x}</li>)}</ul> </div> </div> </section>
<section class="section bg-sand"> <div class="container grid-2"> <div class="reveal"> <p class="eyebrow mb-2">Sede</p> <h2 class="h2">{site.indirizzo.citta} e provincia</h2> <p class="lead mt-3">{site.indirizzo.via}, {site.indirizzo.cap} {site.indirizzo.citta} ({site.indirizzo.provincia}). Lavoriamo in tutta la provincia di Savona.</p> <div class="btn-row mt-4"> <a href="/contatti/" class="btn btn-primary">Contatti</a> <a href={site.mapsUrl} target="_blank" rel="noopener" class="btn btn-outline">Indicazioni</a> </div> </div> <div class="reveal"> <ul class="checklist lead"> {competenzeStudio.map((c) => <li>{c}</li>)} </ul> </div> </div> </section>
<Cta />
</Layout>
