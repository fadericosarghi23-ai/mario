---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { site, abs } from '../data/site';
import { servizi } from '../data/servizi';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Contatti', href: '/contatti/' }];
const ld = [{
  '@type': 'ContactPoint',
  '@id': abs('/contatti/#contatto'),
  contactType: 'customer service',
  ...(site.telefonoE164 ? { telephone: site.telefonoE164 } : {}),
  email: site.email,
  areaServed: site.contattoPaesi,
  availableLanguage: site.contattoLingue,
}];
// Form: collegato solo se site.form è configurato. Altrimenti, con site.form.mailto, il submit
// apre il programma di posta già compilato (data-mailto); senza nemmeno quello è bloccato.
// [[DA COMPILARE: collegare il form in src/data/site.ts]] — oggi non invia da nessuna parte.
const f = site.form;
const collegato = f.netlify || f.endpoint !== '';
const action = f.netlify ? '/grazie/' : f.endpoint || '#';
---
<Layout title="Contatti e preventivi | Impresa Edile Mario, Savona" description="Richiedi un preventivo gratuito all’Impresa Edile Mario: sede in via Fratelli Canepa 6/10, Savona. Lavori in tutta la provincia." pageType="ContactPage" ogType="article" crumbs={crumbs} ld={ld}>
<PageHead crumbs={crumbs} eyebrow="Contatti" title="Richiedi un preventivo gratuito"> <p class="lead mt-3 narrow">Raccontaci il lavoro che hai in mente: ti ricontattiamo per un preventivo gratuito e senza impegno, a Savona e in tutta la provincia.</p> </PageHead>
<section class="section"> <div class="container contact-layout"> <div class="contact-side"> <div class="info-cards"> <div class="info-card"> <h2><Icon name="pin" class="ic" /> {site.indirizzo.citta}</h2> <p>{site.indirizzo.via}<br>{site.indirizzo.cap} {site.indirizzo.citta} ({site.indirizzo.provincia}), Italia</p> <a href={site.mapsUrl} target="_blank" rel="noopener" class="text-link link-underline">Indicazioni stradali</a> </div> <div class="info-card"> <h2><Icon name="pin" class="ic" /> Zona di lavoro</h2> <p>Savona e tutta la provincia</p> <a href="/servizi/" class="text-link link-underline">I servizi</a> </div> <div class="info-card"> <h2><Icon name="email" class="ic" /> Email</h2> <p><a href={`mailto:${site.email}`}>{site.email}</a></p> <a href={`mailto:${site.email}`} class="text-link link-underline">Scrivici</a> </div> <div class="info-card"> <h2><Icon name="telefono" class="ic" /> {site.telefono ? 'Telefono' : 'Dati aziendali'}</h2> {site.telefono ? <p><a href={`tel:${site.telefonoE164}`}>{site.telefono}</a></p> : <p>{site.ragioneSociale || site.nome}<br>P.IVA {site.piva}</p>} </div> </div> <div class="map-box"> <MapEmbed span={0.01} /> </div> <p class="xs muted">Mappa © OpenStreetMap contributors · {site.indirizzo.citta}</p> </div> <div id="richiesta" class="form-card"> <h2 class="h3">Chiedi un preventivo</h2> <p class="mt-1 muted">Compila il modulo: ti rispondiamo il prima possibile.</p> <form class="form" name="contatti" method="POST" action={action} data-netlify={f.netlify ? 'true' : undefined} netlify-honeypot={f.netlify ? 'indirizzo-web' : undefined} data-form-off={collegato ? undefined : ''} data-mailto={collegato ? undefined : f.mailto}> <input type="hidden" name="form-name" value="contatti"> <p class="hp"><label>Non compilare: <input name="indirizzo-web" tabindex="-1" autocomplete="off"></label></p> <div class="two"> <div class="field"><label for="f-nome">Nome *</label><input id="f-nome" name="nome" required autocomplete="name"></div> <div class="field"><label for="f-email">Email *</label><input id="f-email" name="email" type="email" required autocomplete="email"></div> </div> <div class="two"> <div class="field"><label for="f-tel">Telefono</label><input id="f-tel" name="telefono" type="tel" autocomplete="tel"></div> <div class="field"><label for="f-comune">Comune</label><input id="f-comune" name="comune" autocomplete="address-level2"></div> </div> <div class="field"> <label for="f-servizio">Di che lavoro si tratta?</label> <select id="f-servizio" name="servizio"> <option value="">Scegli un servizio</option> {servizi.map((s) => <option>{s.nome}</option>)} <option>Altro</option> </select> </div> <div class="field"> <label for="f-msg">Messaggio *</label> <textarea id="f-msg" name="messaggio" required placeholder="Descrivi brevemente il lavoro da fare"></textarea> </div> <label class="check"> <input type="checkbox" name="privacy" required> <span>Ho letto la <a href="/privacy-policy/">privacy policy</a> e acconsento al trattamento dei miei dati per ricevere una risposta. *</span> </label> <div><button type="submit" class="btn btn-primary">Invia la richiesta</button></div> </form> </div> </div> </section>
<script>
// Finché il form non è collegato (src/data/site.ts → form): con data-mailto apre il programma di
// posta con il messaggio già compilato, altrimenti l'invio è bloccato.
const off = document.querySelector('form[data-form-off]');
off?.addEventListener('submit', (ev) => {
  ev.preventDefault();
  const to = off.getAttribute('data-mailto');
  if (!to) { alert('Sito in bozza: il modulo non è ancora attivo e non invia richieste.'); return; }
  const d = new FormData(off);
  const body = ['Nome: ' + (d.get('nome') || ''), 'Email: ' + (d.get('email') || ''), 'Telefono: ' + (d.get('telefono') || ''), 'Comune: ' + (d.get('comune') || ''), 'Servizio: ' + (d.get('servizio') || ''), '', String(d.get('messaggio') || '')].join('\n');
  window.location.href = 'mailto:' + to + '?subject=' + encodeURIComponent('Richiesta dal sito') + '&body=' + encodeURIComponent(body);
});
</script>
</Layout>
